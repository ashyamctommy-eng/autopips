modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Autopipsz Local Redis"

[[workflows.workflow]]
name = "Autopipsz Local Redis"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p .cache/autopips-redis && exec redis-server --bind 127.0.0.1 --port 6379 --protected-mode yes --appendonly yes --dir .cache/autopips-redis"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["redis"]

[userenv]

[userenv.shared]
REDIS_URL = "redis://127.0.0.1:6379"
EXECUTION_MODE = "internal"
DERIV_APP_ID = "1089"
MARKET_DATA_PROVIDER = "twelve"

[userenv.production]
ADMIN_SETUP_EMAIL = "ceo@autopips.pro"
VITE_API_BASE_URL = "https://autopips.onrender.com"
