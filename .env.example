###############################################################################
# Autopipsz — autopips.pro
# Environment configuration template.
#
#   cp .env.example .env && fill in real values.
#
# SECURITY CONTRACT
#   * This file is the ONLY place secrets are declared.
#   * No secret below may ever be prefixed with NEXT_PUBLIC_ — anything with
#     that prefix is inlined into the browser bundle.
#   * .env is git-ignored. Never commit a populated copy.
#   * MetaApi / NOWPayments credentials are read exclusively in
#     server-side modules under src/server/** and src/app/api/**.
###############################################################################

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://autopips.pro
NEXT_PUBLIC_APP_NAME=Autopipsz
# Port for the standalone WebSocket / bot-runtime process (src/server/main.ts)
WS_PORT=4001
# Shared secret the Next.js app uses to broadcast into the socket runtime
WS_INTERNAL_TOKEN=change-me-openssl-rand-hex-32

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://autopips:CHANGE_ME@127.0.0.1:5432/autopips?schema=public&connection_limit=10

# ─── Cache / rate-limit / socket state (Redis) ──────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48   (JWT signing key — rotating this invalidates sessions)
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=autopips.pro
JWT_AUDIENCE=autopips-pro-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# TOTP issuer label shown in Google Authenticator / Authy
TOTP_ISSUER=Autopipsz

# ─── Credential encryption at rest (AES-256-GCM) ────────────────────────────
# 32-byte key, base64. Encrypts MetaApi tokens + payout keys stored in the DB.
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ─── KYC documents ──────────────────────────────────────────────────────────
# There is no object-storage configuration here on purpose: identity documents
# are encrypted with AES-256-GCM (key derived from CREDENTIAL_ENCRYPTION_KEY)
# and stored in the platform's own Postgres. No bucket, no external provider.

# ─── NOWPayments.io ─────────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=CHANGE_ME
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
# IPN secret from NOWPayments dashboard → Store Settings → IPN.
# Used for HMAC-SHA512 verification of the x-nowpayments-sig header.
NOWPAYMENTS_IPN_SECRET=CHANGE_ME
# Optional: fixed payout wallet for withdrawals. Leave blank to use the
# NOWPayments custodial payout flow (requires JWT-authenticated payout API).
NOWPAYMENTS_PAYOUT_WALLET=
NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20
# Allow-list of crypto currencies offered on the deposit screen.
NOWPAYMENTS_ALLOWED_CURRENCIES=usdttrc20,usdterc20,btc,eth,ltc,trx,bnb

# ─── Payout controls (also editable in Admin → Settings) ────────────────────
# The SAME three settings the console edits. A stored console value wins; these
# variables are the fallback and the default. The withdrawal path reads them:
#
# Largest total USD value of withdrawals ONE client may request per UTC day,
# summed over every non-failed withdrawal. 0 (the default) = no cap. Enforced
# inside the balance-reservation transaction, so concurrent requests cannot
# exceed it.
PAYOUT_DAILY_CAP_USD=0
# Comma-separated payout addresses a withdrawal may target. EMPTY = no
# restriction (the default). Checked both when a client requests a withdrawal
# and again immediately before an automated broadcast.
PAYOUT_ADDRESS_ALLOWLIST=
# Default ON. An automated payout BROADCAST then needs a second, DIFFERENT
# admin: the first admin records the approval, a different admin releases it.
# Recording a txHash by hand (manual settlement) is NEVER blocked by this, so a
# single-operator deployment can always settle; set this to false only if one
# admin must be able to move money on their own.
PAYOUT_TWO_PERSON_APPROVAL=true

# ─── Deriv (broker + market data, WebSocket API) ────────────────────────────
# The app_id you register at https://developers.deriv.com. It is sent as the
# socket's app_id parameter and as the `Deriv-App-ID` header on REST calls.
DERIV_APP_ID=
# Personal Access Token (pat_…) from Deriv, with READ + TRADE scopes. OPTIONAL
# on purpose: market data is public, so charts work without it; account state
# and trading do not. It can also be set at runtime in Admin → Platform
# settings, which is why boot does not require it.
DERIV_API_TOKEN=
# Public market-data socket. Deriv RETIRED the old host (ws.derivws.com now
# answers Cloudflare 520 to every request); the environment contract refuses it,
# so leave this at the default unless you are routing through a proxy.
DERIV_API_URL=wss://api.derivws.com/trading/v1/options/ws/public
# REST base used for account/trading calls (account list, per-account OTP for an
# authenticated socket).
DERIV_REST_URL=https://api.derivws.com
# Contract multiplier for MULTUP/MULTDOWN orders.
DERIV_MULTIPLIER=100
# Seconds between broker state polls in the sync worker.
BROKER_SYNC_INTERVAL=15
# Apply the platform's own pre-trade risk gate to broker orders.
BROKER_RISK_MANAGEMENT_ENABLED=true
# Seconds to wait for a Deriv connection/authorisation.
BROKER_CONNECT_TIMEOUT=120
# ── broker ↔ ledger reconciliation alerts (BROKER_RECONCILE_*) ──
# The reconciliation report is read-only and silently writes nothing while the
# broker and the ledger agree. These three limits decide when a disagreement is
# loud enough to alert: an audit row (BROKER_RECONCILIATION_DRIFT) plus an admin
# activity, throttled so a persistent drift cannot write a row per poll. A value
# that is absent, unparsable or negative falls back to the default below, with a
# warning — an unset variable must never silence the check.
# Absolute USD tolerance on (broker equity − ledger deployed equity).
BROKER_RECONCILE_EQUITY_DRIFT_USD=1
# Absolute tolerance on (broker open positions − booked OPEN trades). 0 = any mismatch.
BROKER_RECONCILE_POSITION_DRIFT=0
# Minimum seconds between two drift alerts for the same connection.
BROKER_RECONCILE_ALERT_COOLDOWN_SEC=900

# ─── Risk engine / business guards ──────────────────────────────────────────
# Master account equity floor: bot halts new entries below this USD value.
RISK_MASTER_EQUITY_FLOOR_USD=0
# Max concurrent open positions across all clients.
RISK_MAX_OPEN_POSITIONS=50
# Max lot size permitted for a single client order.
RISK_MAX_LOT_PER_ORDER=10
# Minimum client capital required before the allocator will mirror a trade.
RISK_MIN_CLIENT_CAPITAL_USD=100
# Performance-fee high-water-mark enabled.
RISK_HWM_ENABLED=true

# ─── Bot control / the kill switch ──────────────────────────────────────────
# THE GLOBAL KILL SWITCH. `false` rejects every new order immediately, in every
# process, and the worker's boot supervisor keeps the process up while trading is
# stopped. LEAVE THIS AT `false` UNTIL YOU ARE READY FOR ORDERS TO BE PLACED —
# an unset value means "running".
#
# The admin console (Admin → Bot control) can change this at runtime without a
# redeploy, and a console value then OVERRIDES this variable. `/healthz` on the
# worker reports the effective bot state under `trading`.
BOT_ENABLED=false
# Why trading is stopped. Shown in the console and written to the audit log with
# the state change. Required by the console when stopping; ignored when running.
BOT_DISABLED_REASON=

# ─── Bot risk limits (also editable in Admin → Bot control) ─────────────────
# These four are the SAME settings the console edits. A value stored in the
# console wins; these variables are the fallback and the default. 0 disables a
# limit unless stated otherwise.
# Upper bound on a single contract's stake (0 = no cap).
RISK_MAX_STAKE_USD=0
# Percent of an investment's capital a single order may put at risk. On a stake
# broker the stake IS the maximum loss, so this is the loss budget per order.
# 0 refuses every stake-sized order.
RISK_PER_TRADE_PCT=1
# Refuse new orders once realised P/L for the UTC day is at or below minus this.
RISK_DAILY_LOSS_LIMIT_USD=0
# Comma-separated broker symbols the bot may trade. EMPTY = no restriction, and
# symbols are CASE-SENSITIVE (Deriv's gold is `frxXAUUSD`).
RISK_ALLOWED_SYMBOLS=
# Refuse a contract whose quoted payout is below this percentage of its cost.
RISK_MIN_PAYOUT_PERCENTAGE=0

# ─── Operations: alerting (src/lib/ops-alert.ts) ────────────────────────────
# Slack-compatible incoming-webhook URL for operational alerts.
#
# OFF BY DEFAULT: leave this blank and `alertOps()` is a silent no-op (no
# network, no Redis, no throw) — the platform behaves exactly as it did before
# this existed. Set it to turn alerting on. What pages: API 5xx responses from
# the `handler()` wrapper (route + method + error message, no request body and
# no PII), and the worker's process-level failures (uncaughtException,
# unhandledRejection, a startup that failed, and a supervised runtime that
# stopped or never started). Identical titles are deduplicated for 5 minutes.
#
# NOT yet wired, and still console + AuditLog only: BROKER_ERROR bursts,
# DEPOSIT_IPN_REJECTED, and bot `degraded` transitions — poll `/healthz`
# `trading.status` (or `?strict=1`) for those in the meantime.
#
# SECRET: anyone holding this URL can post into the channel. It is read
# server-side only — never give it a NEXT_PUBLIC_ prefix.
OPS_ALERT_WEBHOOK_URL=

# ─── Operations: backups (scripts/backup-db.sh — NOT read by the app) ───────
# Output directory for the timestamped pg_dump files. The script defaults to
# ./backups; use an absolute path on a mounted volume in production.
BACKUP_DIR=./backups
# How many autopips-*.dump files to keep. Older files are pruned after a
# successful dump. Must be >= 1. The script defaults to 14.
BACKUP_RETENTION=14
