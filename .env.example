###############################################################################
# Autopipsz — autopips.pro
# Environment configuration template.
#
#   cp .env.example .env && fill in real values.
#
# SECURITY CONTRACT
#   * This file is the ONLY place secrets are declared.
#   * No secret below may ever be prefixed with NEXT_PUBLIC_ — anything with
#     that prefix is inlined into the browser bundle.
#   * .env is git-ignored. Never commit a populated copy.
#   * MetaApi / NOWPayments / S3 credentials are read exclusively in
#     server-side modules under src/server/** and src/app/api/**.
###############################################################################

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://autopips.pro
NEXT_PUBLIC_APP_NAME=Autopipsz
# Port for the standalone WebSocket / bot-runtime process (src/server/main.ts)
WS_PORT=4001
# Shared secret the Next.js app uses to broadcast into the socket runtime
WS_INTERNAL_TOKEN=change-me-openssl-rand-hex-32

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://autopips:CHANGE_ME@127.0.0.1:5432/autopips?schema=public&connection_limit=10

# ─── Cache / rate-limit / socket state (Redis) ──────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48   (JWT signing key — rotating this invalidates sessions)
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=autopips.pro
JWT_AUDIENCE=autopips-pro-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# TOTP issuer label shown in Google Authenticator / Authy
TOTP_ISSUER=Autopipsz

# ─── Credential encryption at rest (AES-256-GCM) ────────────────────────────
# 32-byte key, base64. Encrypts MetaApi tokens + payout keys stored in the DB.
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ─── AWS S3 (private KYC document bucket) ───────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Bucket MUST have Block Public Access enabled and no public bucket policy.
AWS_KYC_BUCKET=autopips-kyc-private
# SSE-KMS key ARN (preferred). Leave blank to fall back to SSE-AES256.
AWS_KMS_KEY_ID=
# Pre-signed URL lifetime for admin KYC document review, in seconds.
KYC_SIGNED_URL_TTL=300

# ─── NOWPayments.io ─────────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=CHANGE_ME
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
# IPN secret from NOWPayments dashboard → Store Settings → IPN.
# Used for HMAC-SHA512 verification of the x-nowpayments-sig header.
NOWPAYMENTS_IPN_SECRET=CHANGE_ME
# Optional: fixed payout wallet for withdrawals. Leave blank to use the
# NOWPayments custodial payout flow (requires JWT-authenticated payout API).
NOWPAYMENTS_PAYOUT_WALLET=
NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20
# Allow-list of crypto currencies offered on the deposit screen.
NOWPAYMENTS_ALLOWED_CURRENCIES=usdttrc20,usdterc20,btc,eth,ltc,trx,bnb

# ─── Deriv (broker + market data, WebSocket API) ────────────────────────────
# The app_id you register at https://developers.deriv.com. It is sent as the
# socket's app_id parameter and as the `Deriv-App-ID` header on REST calls.
DERIV_APP_ID=
# Personal Access Token (pat_…) from Deriv, with READ + TRADE scopes. OPTIONAL
# on purpose: market data is public, so charts work without it; account state
# and trading do not. It can also be set at runtime in Admin → Platform
# settings, which is why boot does not require it.
DERIV_API_TOKEN=
# Public market-data socket. Deriv RETIRED the old host (ws.derivws.com now
# answers Cloudflare 520 to every request); the environment contract refuses it,
# so leave this at the default unless you are routing through a proxy.
DERIV_API_URL=wss://api.derivws.com/trading/v1/options/ws/public
# REST base used for account/trading calls (account list, per-account OTP for an
# authenticated socket).
DERIV_REST_URL=https://api.derivws.com
# Contract multiplier for MULTUP/MULTDOWN orders.
DERIV_MULTIPLIER=100
# Seconds between broker state polls in the sync worker.
BROKER_SYNC_INTERVAL=15
# Apply the platform's own pre-trade risk gate to broker orders.
BROKER_RISK_MANAGEMENT_ENABLED=true
# Seconds to wait for a Deriv connection/authorisation.
BROKER_CONNECT_TIMEOUT=120

# ─── Risk engine / business guards ──────────────────────────────────────────
# Master account equity floor: bot halts new entries below this USD value.
RISK_MASTER_EQUITY_FLOOR_USD=0
# Max concurrent open positions across all clients.
RISK_MAX_OPEN_POSITIONS=50
# Max lot size permitted for a single client order.
RISK_MAX_LOT_PER_ORDER=10
# Minimum client capital required before the allocator will mirror a trade.
RISK_MIN_CLIENT_CAPITAL_USD=100
# Performance-fee high-water-mark enabled.
RISK_HWM_ENABLED=true
