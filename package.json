{
  "name": "autopips-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Autopipsz (autopips.pro) \u2014 managed trading platform. Next.js 14 App Router + modular server services + MetaApi broker adapter + NOWPayments settlements.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:ws": "tsx watch src/server/main.ts",
    "build": "prisma generate && next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "start:ws": "tsx src/server/main.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node scripts/bootstrap-admin.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "prisma": {
    "seed": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
