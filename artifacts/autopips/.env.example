# Public Render API origin; no trailing slash or /api suffix.
# These VITE_ values are embedded in the browser bundle and must never contain secrets.
VITE_API_BASE_URL=https://autopips.onrender.com

# Required for Vercel: the public Render service serving /ws/socket.io.
# The API URL above currently returns 404 for that path, so use the Render
# worker's own public HTTPS origin here (not a ws:// or wss:// URL).
VITE_WS_URL=https://autopips-worker.onrender.com

# On Render, add the exact Vercel site origin(s) to CORS_ALLOWED_ORIGINS
# (comma-separated). The API and worker both use this allow-list.
# Keep NEXT_PUBLIC_APP_URL set to the canonical public site URL; the server
# also uses it to construct payment callback URLs.
